# Copia este archivo a .env y rellena tus credenciales.
# NUNCA subas tu .env real a git.

# --- Broker: Alpaca (acciones/ETFs US) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper trading (dinero simulado). Empieza siempre aquí.
ALPACA_PAPER=true
# Para operar con DINERO REAL hacen falta las DOS cosas:
#   1) ALPACA_PAPER=false
#   2) LIVE_TRADING_CONFIRM=YES_I_UNDERSTAND_THE_RISK  (exactamente esta frase)
# Es una salvaguarda a propósito: sin ambas, el bot genera y registra señales
# pero se niega a enviar órdenes reales.
LIVE_TRADING_CONFIRM=

# --- Fuentes de noticias (activa las que tengas) ---
# RSS no necesita API key. Lista separada por comas; si se deja vacío se usan
# unos feeds por defecto (Reuters, CNBC, BBC).
RSS_FEEDS=

# https://newsapi.org (capa gratuita limitada, no apta para tiempo real 24/7)
NEWSAPI_KEY=

# https://finnhub.io (capa gratuita disponible)
FINNHUB_KEY=

# https://developer.x.com — requiere acceso de pago (Basic/Pro) para streaming filtrado
TWITTER_BEARER_TOKEN=
# Cuentas a seguir (sin @), separadas por comas, p.ej: Reuters,business,DeItaone
TWITTER_WATCH_ACCOUNTS=

# --- Clasificador de noticias ---
# false (por defecto) = clasificador por reglas/keywords, gratis y rápido.
# true = usa Claude para decidir relevancia/sentimiento/tickers (más preciso,
#        tiene coste por llamada y algo más de latencia).
USE_LLM_CLASSIFIER=false
ANTHROPIC_API_KEY=

# --- Notificaciones (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Motor ---
POLL_INTERVAL_SECONDS=30
DB_PATH=bot_state.sqlite3
TRADE_ONLY_MARKET_HOURS=true

# --- Gestión de riesgo (en USD salvo que se indique %) ---
MAX_POSITION_USD=500
MAX_POSITION_PCT_EQUITY=0.05
MAX_DAILY_LOSS_USD=300
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=10
COOLDOWN_MINUTES_PER_TICKER=240
MIN_CONFIDENCE=0.65
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
